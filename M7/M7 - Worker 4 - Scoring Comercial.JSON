        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"number\"\n    },\n    \"level\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ALTA\",\n        \"MEDIA\",\n        \"BAJA\",\n        \"DATOS_INSUFICIENTES\"\n      ]\n    },\n    \"breakdown\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"intencion\": {\n          \"type\": \"number\"\n        },\n        \"urgencia\": {\n          \"type\": \"number\"\n        },\n        \"presupuesto\": {\n          \"type\": \"number\"\n        },\n        \"autoridad\": {\n          \"type\": \"number\"\n        },\n        \"fit_documental\": {\n          \"type\": \"number\"\n        },\n        \"engagement\": {\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"intencion\",\n        \"urgencia\",\n        \"presupuesto\",\n        \"autoridad\",\n        \"fit_documental\",\n        \"engagement\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"evidence\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"missing_data\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"next_action\": {\n      \"type\": \"string\"\n    },\n    \"hitl_required\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"score\",\n    \"level\",\n    \"breakdown\",\n    \"evidence\",\n    \"missing_data\",\n    \"next_action\",\n    \"hitl_required\"\n  ],\n  \"additionalProperties\": false\n}"
